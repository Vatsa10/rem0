# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+91...

# Sarvam AI
SARVAM_API_KEY=

# LLM (Groq or Sarvam)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# Redis / Memurai (for greeting audio cache)
REDIS_URL=redis://localhost:6379/0

# Server (public URL — used by Twilio for webhook callbacks)
SERVER_URL=https://your-domain.com
