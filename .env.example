# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+91...

# Sarvam AI
SARVAM_API_KEY=

# LLM (Groq or Sarvam)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Application
COMPANY_NAME="Your Company"
AGENT_NAME="Subscription Specialist"
SERVER_URL=https://your-domain.com
DEFAULT_LANGUAGE=hi-IN

# Call Settings
DAYS_BEFORE_RENEWAL=30
DAYS_BETWEEN_CALLS=7
